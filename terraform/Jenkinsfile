pipeline {
    agent {
        label 'jenkins-agent-1 || built-in'
    }
    environment {
        AWS_REGION     = 'us-east-1'
        TF_WORKING_DIR = 'terraform'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')  // Prevent hanging builds
        timestamps()                        // Better log timestamps
        retry(1)                            // Retry whole pipeline once on failure (optional)
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
                sh 'echo "Code Checked Out Successfully"'
            }
        }

        stage('Terraform Init') {
            steps {
                dir("${TF_WORKING_DIR}") {
                    retry(3) {
                        sh '''
                            echo "Running Terraform Init..."
                            terraform init -upgrade
                        '''
                    }
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir("${TF_WORKING_DIR}") {
                    sh '''
                        echo "Validating Terraform Configuration..."
                        terraform validate
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-key', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    dir("${TF_WORKING_DIR}") {
                        sh '''
                            echo "📋 Running Terraform Plan..."
                            export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
                            export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
                            export AWS_DEFAULT_REGION=$AWS_REGION

                            terraform plan \
                                -var-file="dev.tfvars" \
                                -no-color \
                                -out=plan.tfplan
                        '''
                    }
                }
            }
        }

        stage('Manual Approval') {
            when {
                branch 'main'
            }
            steps {
                input message: 'Do you want to apply these changes?', 
                      ok: 'Apply'
            }
        }

        stage('Terraform Apply') {
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-key', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    dir("${TF_WORKING_DIR}") {
                        sh '''
                            echo "Running Terraform Apply..."
                            export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
                            export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
                            export AWS_DEFAULT_REGION=$AWS_REGION

                            terraform apply \
                                -var-file="dev.tfvars" \
                                -auto-approve
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Terraform Deployment Completed Successfully!'
        }
        failure {
            echo 'Terraform Deployment Failed!'
        }
        always {
            cleanWs()
        }
    }
}